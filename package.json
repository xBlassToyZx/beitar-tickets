{
  "name": "beitar-tickets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ticketing web app for Beitar Jerusalem home matches at Teddy Stadium (learning project, demo data).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:migrate && npm run db:seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "12.11.1",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "dotenv": "^16.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
